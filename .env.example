# Port web UI + API
PORT=3000

# Token pengaman API & UI. WAJIB diisi kalau app di-expose ke internet
# (mis. via Cloudflare Tunnel). Buat dengan: openssl rand -hex 16
# (Windows PowerShell: [guid]::NewGuid().ToString("N"))
BRIDGE_TOKEN=

# Path ke binary adb (default: "adb" dari PATH).
# Isi full path kalau adb tidak ada di PATH, mis. C:\platform-tools\adb.exe
ADB_PATH=adb

# Serial device default (opsional). Kalau HP cuma satu, kosongkan saja.
# Lihat daftar device di halaman web atau GET /api/devices
ANDROID_SERIAL=
